# EggSort+ environment configuration
# Copy this file to .env and replace placeholder values as needed.

# Flask security and base URL. Use the public HTTPS app URL for emailed invites.
# The default is for local development; other devices cannot open 127.0.0.1.
SECRET_KEY=
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:5000
AUTO_START_SORTING_ON_LOGIN=1

# Supabase PostgreSQL connection URI. Copy it from Supabase: Connect > URI.
# Keep this value private; it includes the database password.
DATABASE_URL=
SUPABASE_DB_URL=
# Google OAuth - required for administrator Google sign-in
GOOGLE_AUTH_CLOCK_SKEW_SECONDS=120
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAIL=capstonecutie1@gmail.com
ADMIN_GOOGLE_SUB=

# Staff invitation email (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=capstonecutie1@gmail.com
MAIL_PASSWORD=
MAIL_FROM=capstonecutie1@gmail.com

# Camera
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_JPEG_QUALITY=72

# YOLO - best.pt in the project root is used when this is left blank/removed
YOLO_MODEL_PATH=C:/Users/Lira Angela Ata/eggsort2/eggsortcapstone/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=512
# Consecutive frames that must agree before one egg quality is locked
CAMERA_QUALITY_SAMPLES=1
CAMERA_INSPECTION_LEFT=0.40
CAMERA_INSPECTION_RIGHT=0.60
CAMERA_INSPECTION_TOP=0.36
CAMERA_INSPECTION_BOTTOM=0.64

# ESP32 - leave the port blank to auto-detect one USB serial controller
ESP32_BAUD_RATE=115200
ESP32_PORT=COM8
