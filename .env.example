# EggSort+ environment configuration
# Copy this file to .env and replace placeholder values as needed.

# Flask security and base URL. Use the public HTTPS app URL for emailed invites.
# The default is for local development; other devices cannot open 127.0.0.1.
SECRET_KEY=
FLASK_DEBUG=0
PUBLIC_BASE_URL=http://127.0.0.1:5000
AUTO_START_SORTING_ON_LOGIN=0
# Local sorting computer: 1. Render dashboard: 0 (also the default on Render).
LOCAL_HARDWARE_ENABLED=1

# Supabase PostgreSQL connection URI. Copy it from Supabase: Connect > URI.
# Keep this value private; it includes the database password.
DATABASE_URL=
# On the local sorting computer, explicitly enable the verified production
# database and sorting writes only after the Supabase schema preflight is done.
# Keep both disabled on disposable/local development and hosted dashboard apps.
# EGGSOR_PRODUCTION_DB_MODE=1
# EGGSOR_PRODUCTION_SORTING_ENABLED=1

# Google OAuth - required for administrator Google sign-in
GOOGLE_AUTH_CLOCK_SKEW_SECONDS=120
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAIL=capstonecutie1@gmail.com
ADMIN_GOOGLE_SUB=

# Staff invitation email (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=capstonecutie1@gmail.com
MAIL_PASSWORD=
MAIL_FROM=capstonecutie1@gmail.com

# Camera
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
# DirectShow: FPS first, dimensions next, MJPG last. false restores old order.
CAMERA_RESOLUTION_NEGOTIATION_FIX=true
# Opt-in verified profile: 1080p_yuy2 forces DSHOW, 1920x1080/30 and exact probe order.
# existing preserves CAMERA_BACKEND/WIDTH/HEIGHT/FPS and current rollback behavior.
CAMERA_CAPTURE_PROFILE=existing
CAMERA_JPEG_QUALITY=72
# Measurement only; no camera/model/servo setting changes. Restart Python to apply.
CAMERA_PERFORMANCE_DIAGNOSTICS=false
# Summaries are clamped to a minimum of 5 seconds; JSONL is saved under TEMP.
CAMERA_PERFORMANCE_INTERVAL_SECONDS=5

# YOLO - best.pt in the project root is used when this is left blank/removed
YOLO_MODEL_PATH=C:/Users/Lira Angela Ata/eggsort2/eggsortcapstone/best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=512
# Opt-in CPU experiment: 0/unset preserves existing behavior; try 4, restart Python.
EGGSORT_CPU_INFERENCE_THREADS=0
# Consecutive frames that must agree before one egg quality is locked
CAMERA_QUALITY_SAMPLES=2
CAMERA_INSPECTION_LEFT=0.25
CAMERA_INSPECTION_RIGHT=0.75
CAMERA_INSPECTION_TOP=0.40
CAMERA_INSPECTION_BOTTOM=0.90
# Optional observation-only collection/export; neither disables legacy hardware commands.
CAMERA_REJECT_DRY_RUN=false
CAMERA_REJECT_DRY_RUN_EXPORT=false

# ESP32 - leave the port blank to auto-detect one USB serial controller
ESP32_BAUD_RATE=115200
ESP32_PORT=COM8
